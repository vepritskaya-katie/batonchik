rules_version = '2';

// Правила доступа к базе «Батончика».
// Читать и менять данные могут только те, чей адрес почты есть в коллекции allowed.
// Коллекцию allowed заполняют вручную в консоли Firebase: ID документа = адрес почты строчными буквами.
// Из приложения её изменить нельзя.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isAllowed() {
      return signedIn() && exists(/databases/$(database)/documents/allowed/$(myEmail()));
    }

    // Отметка: кто (uid и имя) и когда (время сервера)
    function validMark(d) {
      return d.keys().hasOnly(['uid', 'name', 'at'])
        && d.uid == request.auth.uid
        && d.name is string && d.name.size() <= 40
        && d.at == request.time;
    }

    // Список допущенных: каждый может проверить только свой адрес
    match /allowed/{email} {
      allow get: if signedIn() && email == myEmail();
      allow list, write: if false;
    }

    // Отметки за день: один документ на дату (по Москве), поле checks
    match /days/{day} {
      allow read: if isAllowed();
      allow create, update: if isAllowed()
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['checks'])
        && request.resource.data.checks is map
        && request.resource.data.checks.size() <= 200;
      allow delete: if false;
    }

    // «Освоено» и галочки прогресса
    match /marks/{id} {
      allow read: if isAllowed();
      allow create, update: if isAllowed() && id.size() <= 200 && validMark(request.resource.data);
      allow delete: if isAllowed();
    }

    // Распорядок дня и список «Тренируем сейчас»
    match /settings/{doc} {
      allow read: if isAllowed();
      allow create, update: if isAllowed()
        && doc == 'plan'
        && request.resource.data.keys().hasOnly(['schedule', 'focus', 'updatedAt', 'updatedBy'])
        && request.resource.data.schedule is list && request.resource.data.schedule.size() <= 60
        && request.resource.data.focus is list && request.resource.data.focus.size() <= 60
        && request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() <= 40;
      allow delete: if false;
    }

    // Журнал: туалет, аварии, кормления, подъём, отбой, заметки и подходы к тренировкам (train); прогулки — только старые записи
    function validEvent(d) {
      return d.keys().hasOnly(['type', 'sub', 'text', 'at', 'day', 'uid', 'name', 'createdAt', 'card', 'grams'])
        && d.type in ['toilet', 'accident', 'walk', 'meal', 'wake', 'bed', 'note', 'train']
        && (!('card' in d) || (d.card is string && d.card.size() <= 120))
        && (!('grams' in d) || (d.grams is int && d.grams >= 0 && d.grams <= 5000))
        && d.sub in ['', 'pee', 'poo', 'both']
        && d.text is string && d.text.size() <= 2000
        && d.at is timestamp
        && d.day is string && d.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.uid is string && d.name is string && d.name.size() <= 40;
    }

    match /events/{id} {
      allow read: if isAllowed();
      allow create: if isAllowed() && validEvent(request.resource.data)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      // Править время и комментарий может любой из двоих; автор и время создания не меняются
      allow update: if isAllowed() && validEvent(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAllowed();
    }

    // Карточки, добавленные или исправленные в приложении (поверх файлов из папки content)
    match /cards/{id} {
      allow read: if isAllowed();
      allow create, update: if isAllowed()
        && id.size() <= 120
        && request.resource.data.keys().hasOnly(['tab', 'cardId', 'group', 'md', 'deleted', 'updatedAt', 'updatedBy'])
        && request.resource.data.tab in ['k', 'g', 't']
        && request.resource.data.cardId is string && request.resource.data.cardId.size() <= 100
        && id == request.resource.data.tab + '__' + request.resource.data.cardId
        && request.resource.data.group is string && request.resource.data.group.size() <= 200
        && request.resource.data.md is string && request.resource.data.md.size() <= 30000
        && request.resource.data.deleted is bool
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() <= 40;
      allow delete: if isAllowed();
    }

    // Паспорт: карточка собаки (profile) и фото (photo, сжатая картинка в виде строки data:image/…)
    function str(d, key, n) {
      return !(key in d) || (d[key] is string && d[key].size() <= n);
    }
    match /pet/{doc} {
      allow read: if isAllowed();
      allow create, update: if isAllowed() && (
        (doc == 'profile'
          && request.resource.data.keys().hasOnly(['name', 'breed', 'birth', 'sex', 'chip', 'mdr1', 'weight', 'updatedAt', 'updatedBy'])
          && str(request.resource.data, 'name', 40) && str(request.resource.data, 'breed', 60)
          && str(request.resource.data, 'birth', 10) && str(request.resource.data, 'sex', 20)
          && str(request.resource.data, 'chip', 40) && str(request.resource.data, 'mdr1', 60)
          && str(request.resource.data, 'weight', 20)
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() <= 40)
        || (doc == 'vet'
          && request.resource.data.keys().hasOnly(['clinicName', 'clinicAddress', 'clinicPhone', 'vetName', 'vetPhone', 'chipBase', 'updatedAt', 'updatedBy'])
          && str(request.resource.data, 'clinicName', 80) && str(request.resource.data, 'clinicAddress', 160)
          && str(request.resource.data, 'clinicPhone', 30) && str(request.resource.data, 'vetName', 80)
          && str(request.resource.data, 'vetPhone', 30) && str(request.resource.data, 'chipBase', 120)
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() <= 40)
        || (doc == 'photo'
          && request.resource.data.keys().hasOnly(['data', 'updatedAt', 'updatedBy'])
          && request.resource.data.data is string && request.resource.data.data.size() <= 900000
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() <= 40)
        // «Если потерялся»: два контакта, приметы и приписка к объявлению
        || (doc == 'lost'
          && request.resource.data.keys().hasOnly(['name1', 'phone1', 'name2', 'phone2', 'signs', 'note', 'updatedAt', 'updatedBy'])
          && str(request.resource.data, 'name1', 40) && str(request.resource.data, 'phone1', 30)
          && str(request.resource.data, 'name2', 40) && str(request.resource.data, 'phone2', 30)
          && str(request.resource.data, 'signs', 400) && str(request.resource.data, 'note', 300)
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() <= 40)
        // Поля «___» в карточках «Здоровья» («Норма Батончика»): { ключ: { v: значение, d: дата } }
        || (doc == 'fields'
          && request.resource.data.keys().hasOnly(['values', 'updatedAt', 'updatedBy'])
          && request.resource.data.values is map && request.resource.data.values.size() <= 40
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() <= 40)
        // Даты фото месяца: { '5': '2026-10-29' } — чтобы календарь знал, где фото, не загружая их
        || (doc == 'months'
          && request.resource.data.keys().hasOnly(['dates', 'updatedAt', 'updatedBy'])
          && request.resource.data.dates is map && request.resource.data.dates.size() <= 99
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() <= 40));
      allow delete: if isAllowed() && doc == 'photo';
    }

    // Паспорт: прививки, обработки, таблетки, визиты к врачу. done == false — запланировано (напоминание).
    // time — время визита к врачу «ЧЧ:ММ» по Москве, необязательно
    match /health/{id} {
      allow read: if isAllowed();
      allow create, update: if isAllowed()
        && id.size() <= 40
        && request.resource.data.keys().hasOnly(['title', 'kind', 'date', 'time', 'done', 'note', 'updatedAt', 'updatedBy'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.kind in ['vaccine', 'ticks', 'worms', 'pill', 'vet', 'other']
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('time' in request.resource.data) || (request.resource.data.time is string && request.resource.data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && request.resource.data.done is bool
        && request.resource.data.note is string && request.resource.data.note.size() <= 1000
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() <= 40;
      allow delete: if isAllowed();
    }

    // Рост и вес: дата и хотя бы одно из двух — вес в килограммах, рост в холке в сантиметрах
    match /growth/{id} {
      allow read: if isAllowed();
      allow create, update: if isAllowed()
        && id.size() <= 40
        && request.resource.data.keys().hasOnly(['date', 'weight', 'height', 'updatedAt', 'updatedBy'])
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && ('weight' in request.resource.data || 'height' in request.resource.data)
        && (!('weight' in request.resource.data) || (request.resource.data.weight is number && request.resource.data.weight > 0 && request.resource.data.weight <= 150))
        && (!('height' in request.resource.data) || (request.resource.data.height is number && request.resource.data.height > 0 && request.resource.data.height <= 150))
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() <= 40;
      allow delete: if isAllowed();
    }

    // Библиотека: что прочитано (и результаты старых тестов) — у каждого свой документ, чужой не виден
    match /reads/{uid} {
      allow read, delete: if isAllowed() && request.auth.uid == uid;
      allow create, update: if isAllowed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['items', 'quiz', 'updatedAt'])
        && (!('items' in request.resource.data) || (request.resource.data.items is map && request.resource.data.items.size() <= 500))
        && (!('quiz' in request.resource.data) || (request.resource.data.quiz is map && request.resource.data.quiz.size() <= 20))
        && request.resource.data.updatedAt == request.time;
    }

    // «Неделя Батончика»: ответы за воскресенье — три вопроса о благополучии, фигура, заметки,
    // здоровье за неделю (три галочки, найденные клещи, даты последних обработок от клещей и глистов)
    function weekDate(d, key) {
      return !(key in d) || (d[key] is string && (d[key] == '' || d[key].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
    }
    match /weeks/{day} {
      allow read: if isAllowed();
      allow create, update: if isAllowed()
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['joy', 'choice', 'sleep', 'ribs', 'waist', 'notes', 'coat', 'stool', 'vigor', 'ticks', 'lastTicks', 'lastWorms', 'updatedAt', 'updatedBy'])
        && (!('coat' in request.resource.data) || request.resource.data.coat is bool)
        && (!('stool' in request.resource.data) || request.resource.data.stool is bool)
        && (!('vigor' in request.resource.data) || request.resource.data.vigor is bool)
        && str(request.resource.data, 'ticks', 200)
        && weekDate(request.resource.data, 'lastTicks') && weekDate(request.resource.data, 'lastWorms')
        && request.resource.data.joy is bool && request.resource.data.choice is bool && request.resource.data.sleep is bool
        && request.resource.data.ribs in ['', 'yes', 'no'] && request.resource.data.waist in ['', 'yes', 'no']
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 2000
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() <= 40;
      allow delete: if isAllowed();
    }

    // Дневник: заметка о дне (заголовок, текст, «день, который хочется помнить»), один документ на дату
    match /stories/{day} {
      allow read: if isAllowed();
      allow create, update: if isAllowed()
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['title', 'text', 'photo', 'special', 'hasPhoto', 'photoCount', 'photoKey', 'updatedAt', 'updatedBy'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.text is string && request.resource.data.text.size() <= 5000
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() <= 900000))
        && (!('special' in request.resource.data) || request.resource.data.special is bool)
        && (!('hasPhoto' in request.resource.data) || request.resource.data.hasPhoto is bool)
        && (!('photoCount' in request.resource.data) || (request.resource.data.photoCount is int && request.resource.data.photoCount >= 0 && request.resource.data.photoCount <= 10))
        && (!('photoKey' in request.resource.data) || (request.resource.data.photoKey is string && request.resource.data.photoKey.size() <= 24))
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() <= 40;
      allow delete: if isAllowed();
    }

    // Фото к заметке о дне — отдельно, чтобы календарь и список заметок грузились быстро.
    // Первое — под датой (2026-10-04), следующие — с номером (2026-10-04_2 … _10)
    match /storyPhotos/{id} {
      allow read: if isAllowed();
      allow create, update: if isAllowed()
        && id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}(_([2-9]|10))?$')
        && request.resource.data.keys().hasOnly(['data', 'updatedAt', 'updatedBy'])
        && request.resource.data.data is string && request.resource.data.data.size() <= 900000
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() <= 40;
      allow delete: if isAllowed();
    }

    // Социализация: что Батончик уже встретил и как отреагировал. Пункты из списка в приложении
    // и свои (с названием title). log — последние отметки { d: день, r: реакция }
    match /social/{id} {
      allow read: if isAllowed();
      allow create, update: if isAllowed()
        && id.matches('^[a-z0-9-]{1,60}$')
        && request.resource.data.keys().hasOnly(['title', 'log', 'updatedAt', 'updatedBy'])
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 80))
        && request.resource.data.log is list && request.resource.data.log.size() <= 60
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() <= 40;
      allow delete: if isAllowed();
    }

    // Уход: когти, зубы, вычёсывание, уши, купание. log — дни, когда делали; every — раз в сколько дней напоминать
    match /care/{id} {
      allow read: if isAllowed();
      allow create, update: if isAllowed()
        && id in ['nails', 'teeth', 'brush', 'ears', 'bath']
        && request.resource.data.keys().hasOnly(['log', 'every', 'updatedAt', 'updatedBy'])
        && request.resource.data.log is list && request.resource.data.log.size() <= 60
        && request.resource.data.every is int && request.resource.data.every >= 0 && request.resource.data.every <= 120
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() <= 40;
      allow delete: if isAllowed();
    }

    // Фото месяца: одно фото на каждый месяц жизни (1, 2 … 99), сжатая картинка и дата снимка
    match /monthPhotos/{n} {
      allow read: if isAllowed();
      allow create, update: if isAllowed()
        && n.matches('^[1-9][0-9]?$')
        && request.resource.data.keys().hasOnly(['data', 'date', 'updatedAt', 'updatedBy'])
        && request.resource.data.data is string && request.resource.data.data.size() <= 900000
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() <= 40;
      allow delete: if isAllowed();
    }

    // Уведомления: телефоны, где их включили. Документ — на один телефон: токен Firebase Cloud Messaging,
    // чей телефон и какие уведомления на нём включены. Каждый видит и меняет только свои телефоны.
    // Читает их и присылает уведомления сервер (functions) — ему правила не нужны
    function validPush(d) {
      return d.keys().hasOnly(['token', 'uid', 'name', 'platform', 'prefs', 'updatedAt'])
        && d.token is string && d.token.size() > 0 && d.token.size() <= 4096
        && d.uid == request.auth.uid
        && d.name is string && d.name.size() <= 40
        && d.platform in ['ios', 'android', 'other']
        && d.prefs is map && d.prefs.keys().hasOnly(['toilet', 'care', 'week', 'game'])
        && d.prefs.toilet is bool && d.prefs.care is bool && d.prefs.week is bool
        && (!('game' in d.prefs) || d.prefs.game is bool)
        && d.updatedAt == request.time;
    }
    match /pushTokens/{id} {
      allow read, delete: if isAllowed() && resource.data.uid == request.auth.uid;
      allow create: if isAllowed() && id.matches('^[0-9a-f]{40}$') && validPush(request.resource.data);
      allow update: if isAllowed() && resource.data.uid == request.auth.uid && validPush(request.resource.data);
    }

    // Игра «Разминка дня»: у каждого свой документ game/{uid}. Видят оба — для рейтинга, меняет только хозяин.
    // Внутри: разминки по дням, ошибки на повтор, на какие вопросы отвечали верно и когда что прочитали (очки)
    function validGame(d) {
      return d.keys().hasOnly(['name', 'photo', 'days', 'rep', 'known', 'read', 'updatedAt'])
        && d.name is string && d.name.size() <= 60
        && d.photo is string && d.photo.size() <= 600
        && (d.photo == '' || d.photo.matches('^https://[a-z0-9.-]+[.]googleusercontent[.]com/.*$'))
        && (!('days' in d) || (d.days is map && d.days.size() <= 3000))
        && (!('rep' in d) || (d.rep is map && d.rep.size() <= 1000))
        && (!('known' in d) || (d.known is map && d.known.size() <= 3000))
        && (!('read' in d) || (d.read is map && d.read.size() <= 1000))
        && d.updatedAt == request.time;
    }
    match /game/{uid} {
      allow read: if isAllowed();
      allow create, update: if isAllowed() && request.auth.uid == uid && validGame(request.resource.data);
      allow delete: if isAllowed() && request.auth.uid == uid;
    }

    // Всё остальное закрыто (в том числе push/state — что сервер уже прислал)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
