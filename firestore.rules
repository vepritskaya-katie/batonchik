rules_version = '2';

// Правила доступа к базе «Батончика».
// Читать и менять данные могут только те, чей адрес почты есть в коллекции allowed.
// Коллекцию allowed заполняют вручную в консоли Firebase: ID документа = адрес почты строчными буквами.
// Из приложения её изменить нельзя.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isAllowed() {
      return signedIn() && exists(/databases/$(database)/documents/allowed/$(myEmail()));
    }

    // Отметка: кто (uid и имя) и когда (время сервера)
    function validMark(d) {
      return d.keys().hasOnly(['uid', 'name', 'at'])
        && d.uid == request.auth.uid
        && d.name is string && d.name.size() <= 40
        && d.at == request.time;
    }

    // Список допущенных: каждый может проверить только свой адрес
    match /allowed/{email} {
      allow get: if signedIn() && email == myEmail();
      allow list, write: if false;
    }

    // Отметки за день: один документ на дату (по Москве), поле checks
    match /days/{day} {
      allow read: if isAllowed();
      allow create, update: if isAllowed()
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['checks'])
        && request.resource.data.checks is map
        && request.resource.data.checks.size() <= 200;
      allow delete: if false;
    }

    // «Освоено» и галочки прогресса
    match /marks/{id} {
      allow read: if isAllowed();
      allow create, update: if isAllowed() && id.size() <= 200 && validMark(request.resource.data);
      allow delete: if isAllowed();
    }

    // Распорядок дня и список «Тренируем сейчас»
    match /settings/{doc} {
      allow read: if isAllowed();
      allow create, update: if isAllowed()
        && doc == 'plan'
        && request.resource.data.keys().hasOnly(['schedule', 'focus', 'updatedAt', 'updatedBy'])
        && request.resource.data.schedule is list && request.resource.data.schedule.size() <= 60
        && request.resource.data.focus is list && request.resource.data.focus.size() <= 60
        && request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() <= 40;
      allow delete: if false;
    }

    // Журнал: туалет, прогулки, кормления, подъём, отбой, заметки и подходы к тренировкам (train)
    function validEvent(d) {
      return d.keys().hasOnly(['type', 'sub', 'text', 'at', 'day', 'uid', 'name', 'createdAt', 'card', 'grams'])
        && d.type in ['toilet', 'accident', 'walk', 'meal', 'wake', 'bed', 'note', 'train']
        && (!('card' in d) || (d.card is string && d.card.size() <= 120))
        && (!('grams' in d) || (d.grams is int && d.grams >= 0 && d.grams <= 5000))
        && d.sub in ['', 'pee', 'poo', 'both']
        && d.text is string && d.text.size() <= 2000
        && d.at is timestamp
        && d.day is string && d.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.uid is string && d.name is string && d.name.size() <= 40;
    }

    match /events/{id} {
      allow read: if isAllowed();
      allow create: if isAllowed() && validEvent(request.resource.data)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      // Править время и комментарий может любой из двоих; автор и время создания не меняются
      allow update: if isAllowed() && validEvent(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAllowed();
    }

    // Карточки, добавленные или исправленные в приложении (поверх файлов из папки content)
    match /cards/{id} {
      allow read: if isAllowed();
      allow create, update: if isAllowed()
        && id.size() <= 120
        && request.resource.data.keys().hasOnly(['tab', 'cardId', 'group', 'md', 'deleted', 'updatedAt', 'updatedBy'])
        && request.resource.data.tab in ['k', 'g', 't']
        && request.resource.data.cardId is string && request.resource.data.cardId.size() <= 100
        && id == request.resource.data.tab + '__' + request.resource.data.cardId
        && request.resource.data.group is string && request.resource.data.group.size() <= 200
        && request.resource.data.md is string && request.resource.data.md.size() <= 30000
        && request.resource.data.deleted is bool
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() <= 40;
      allow delete: if isAllowed();
    }

    // Паспорт: карточка собаки (profile) и фото (photo, сжатая картинка в виде строки data:image/…)
    function str(d, key, n) {
      return !(key in d) || (d[key] is string && d[key].size() <= n);
    }
    match /pet/{doc} {
      allow read: if isAllowed();
      allow create, update: if isAllowed() && (
        (doc == 'profile'
          && request.resource.data.keys().hasOnly(['name', 'breed', 'birth', 'sex', 'chip', 'mdr1', 'weight', 'updatedAt', 'updatedBy'])
          && str(request.resource.data, 'name', 40) && str(request.resource.data, 'breed', 60)
          && str(request.resource.data, 'birth', 10) && str(request.resource.data, 'sex', 20)
          && str(request.resource.data, 'chip', 40) && str(request.resource.data, 'mdr1', 60)
          && str(request.resource.data, 'weight', 20)
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() <= 40)
        || (doc == 'vet'
          && request.resource.data.keys().hasOnly(['clinicName', 'clinicAddress', 'clinicPhone', 'vetName', 'vetPhone', 'updatedAt', 'updatedBy'])
          && str(request.resource.data, 'clinicName', 80) && str(request.resource.data, 'clinicAddress', 160)
          && str(request.resource.data, 'clinicPhone', 30) && str(request.resource.data, 'vetName', 80)
          && str(request.resource.data, 'vetPhone', 30)
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() <= 40)
        || (doc == 'photo'
          && request.resource.data.keys().hasOnly(['data', 'updatedAt', 'updatedBy'])
          && request.resource.data.data is string && request.resource.data.data.size() <= 900000
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() <= 40));
      allow delete: if isAllowed() && doc == 'photo';
    }

    // Паспорт: прививки, обработки, таблетки, визиты к врачу. done == false — запланировано (напоминание)
    match /health/{id} {
      allow read: if isAllowed();
      allow create, update: if isAllowed()
        && id.size() <= 40
        && request.resource.data.keys().hasOnly(['title', 'kind', 'date', 'done', 'note', 'updatedAt', 'updatedBy'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.kind in ['vaccine', 'ticks', 'worms', 'pill', 'vet', 'other']
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.done is bool
        && request.resource.data.note is string && request.resource.data.note.size() <= 1000
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() <= 40;
      allow delete: if isAllowed();
    }

    // Рост и вес: дата и хотя бы одно из двух — вес в килограммах, рост в холке в сантиметрах
    match /growth/{id} {
      allow read: if isAllowed();
      allow create, update: if isAllowed()
        && id.size() <= 40
        && request.resource.data.keys().hasOnly(['date', 'weight', 'height', 'updatedAt', 'updatedBy'])
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && ('weight' in request.resource.data || 'height' in request.resource.data)
        && (!('weight' in request.resource.data) || (request.resource.data.weight is number && request.resource.data.weight > 0 && request.resource.data.weight <= 150))
        && (!('height' in request.resource.data) || (request.resource.data.height is number && request.resource.data.height > 0 && request.resource.data.height <= 150))
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() <= 40;
      allow delete: if isAllowed();
    }

    // Библиотека: что прочитано и лучшие результаты тестов — у каждого свой документ, чужой не виден
    match /reads/{uid} {
      allow read, delete: if isAllowed() && request.auth.uid == uid;
      allow create, update: if isAllowed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['items', 'quiz', 'updatedAt'])
        && (!('items' in request.resource.data) || (request.resource.data.items is map && request.resource.data.items.size() <= 500))
        && (!('quiz' in request.resource.data) || (request.resource.data.quiz is map && request.resource.data.quiz.size() <= 20))
        && request.resource.data.updatedAt == request.time;
    }

    // «Неделя Батончика»: ответы за воскресенье — три вопроса о благополучии, фигура, заметки
    match /weeks/{day} {
      allow read: if isAllowed();
      allow create, update: if isAllowed()
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['joy', 'choice', 'sleep', 'ribs', 'waist', 'notes', 'updatedAt', 'updatedBy'])
        && request.resource.data.joy is bool && request.resource.data.choice is bool && request.resource.data.sleep is bool
        && request.resource.data.ribs in ['', 'yes', 'no'] && request.resource.data.waist in ['', 'yes', 'no']
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 2000
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() <= 40;
      allow delete: if isAllowed();
    }

    // Дневник: заметка о дне (заголовок, текст, «день, который хочется помнить»), один документ на дату
    match /stories/{day} {
      allow read: if isAllowed();
      allow create, update: if isAllowed()
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['title', 'text', 'photo', 'special', 'hasPhoto', 'updatedAt', 'updatedBy'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.text is string && request.resource.data.text.size() <= 5000
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() <= 900000))
        && (!('special' in request.resource.data) || request.resource.data.special is bool)
        && (!('hasPhoto' in request.resource.data) || request.resource.data.hasPhoto is bool)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() <= 40;
      allow delete: if isAllowed();
    }

    // Фото к заметке о дне — отдельно, чтобы календарь и список заметок грузились быстро
    match /storyPhotos/{day} {
      allow read: if isAllowed();
      allow create, update: if isAllowed()
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['data', 'updatedAt', 'updatedBy'])
        && request.resource.data.data is string && request.resource.data.data.size() <= 900000
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() <= 40;
      allow delete: if isAllowed();
    }

    // Всё остальное закрыто
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
